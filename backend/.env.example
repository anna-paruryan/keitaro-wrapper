# --- Keitaro ---------------------------------------------------------------
# Адрес трекера (можно с /admin на конце, лишнее обрежется)
KEITARO_URL=https://tlgk.host
# Ключ Admin API: админка -> Профиль -> API ключи
KEITARO_API_KEY=

# Префикс для кампаний из условия: test_<фамилия>_
# Он добавляется к названию автоматически. Если задан, редактор по умолчанию
# показывает и разрешает менять только кампании с этим префиксом
# (в общем тестовом трекере чужие кампании случайно не заденешь).
CAMPAIGN_PREFIX=test_ivanov_

# Что выбрать по умолчанию в форме создания (можно сменить в самой форме).
# Группа и источник ищутся по названию среди того, что отдаёт API.
KEITARO_GROUP_NAME=FORTESTS
KEITARO_SOURCE_NAME=FORTESTS
# Домен: часть названия. Если пусто, берётся первый из списка API.
KEITARO_DOMAIN=in.posdk.xyz

# Куда редиректит первый поток (страна из формы)
GOOGLE_REDIRECT_URL=https://www.google.com

# --- Приложение --------------------------------------------------------------
# SQLite по умолчанию. Для Postgres:
#   DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/keitaro_tools
# (и pip install "psycopg[binary]")
DATABASE_URL=sqlite:///./data/app.db

# Сколько секунд кэшировать список офферов для автокомплита
OFFERS_CACHE_TTL=300

# Обычно не нужно: имя фильтра по стране. По умолчанию определяется
# автоматически через GET /stream_filters.
COUNTRY_FILTER_NAME=
